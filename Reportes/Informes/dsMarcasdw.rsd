<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="DataSet1">
    <Query>
      <DataSourceReference>BikeSotesDW</DataSourceReference>
      <CommandText>SELECT BrandID, BrandName
FROM (
    SELECT 
        CAST(NULL AS INT) AS BrandID,
        'Todas las marcas' AS BrandName
    UNION ALL
    SELECT DISTINCT
        BrandID,
        BrandName
    FROM dbo.DimProducts
) AS B
ORDER BY
    CASE WHEN BrandID IS NULL THEN 0 ELSE 1 END,
    BrandName;
</CommandText>
    </Query>
    <Fields>
      <Field Name="BrandID">
        <DataField>BrandID</DataField>
        <rd:TypeName>System.Int32</rd:TypeName>
      </Field>
      <Field Name="BrandName">
        <DataField>BrandName</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>